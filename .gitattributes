# Normalize line endings so a checkout on Windows does not turn every shell
# script into something the runner cannot execute.
* text=auto eol=lf

*.sh   text eol=lf
*.py   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.md   text eol=lf

*.png binary
*.jpg binary
*.gif binary
*.ico binary
